{
  "name": "voice-app-workspace",
  "private": true,
  "packageManager": "pnpm@10.15.1",
  "scripts": {
    "dev": "pnpm --dir apps/desktop dev",
    "build": "pnpm --dir apps/desktop build",
    "build:mac": "pnpm --dir apps/desktop exec tauri build --bundles app,dmg --target universal-apple-darwin --ci --no-sign",
    "test": "pnpm --dir apps/desktop test"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@tauri-apps/cli": "^2.10.1",
    "open": "^10.2.0",
    "zod": "^4.3.6"
  }
}
